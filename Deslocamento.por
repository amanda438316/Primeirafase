programa {
  funcao inicio() {
logico estarGripado 
inteiro tempodeViagem 

escreva("esta gripado? (verdadeiro/falso): " ) 
leia(estarGripado)

escreva("Tempo de viagem em minutos: ")
leia(tempodeViagem) 
 
se (nao estarGripado e tempodeViagem <45) {
escreva("Viagem autorizada. Rumo ao show!") 

}senao{
escreva("deslocamento inviavel. Melhor recusa esses eveneto.")

}






  }
}
