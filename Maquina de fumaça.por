programa {
  funcao inicio() {
inteiro criancasPequenas
real velocidadeVento

escreva(" Digite a quantidade de crianças pequenas proximas: ") 
leia(criancasPequenas)  

escreva("Digite velocidade do vento (em m/s):")
leia(velocidadeVento) 

se(criancasPequenas == 0 e velocidadeVento >= 0.5) {
escreva("Fumaça liberada. que comecem os misterios!") 
}senao{ 
  escreva("fumaça bloqueadada. aguardar condiçoes ideias. ")

}












  }
}
