programa {
  funcao inicio() {
// Entendimentontretetimento
// Infos
// entrada de dados
// Processamento
// Saída
real gastos, venda_ingresssos, venda_itens
real lucro_reias, lucro_percentual
escreva ("Valor do ingresso R$ ?")
leia  (venda_ingresssos)
escreva ("Valor de venda do itens: R$?")
leia  (venda_itens)
escreva (" Quanto  teve de gastos ?")
leia ( gastos)
lucro_reias = venda_itens + venda_ingresssos - gastos 
lucro_percentual = (lucro_reias/gastos ) *100
escreva ("lucro de hoje : R$" + lucro_reias)
escreva ("\n lucro percentual de hoje : R$" + lucro_percentual)




















  }
}
