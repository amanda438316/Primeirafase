programa {
  funcao inicio() {
// entendimento
// Calcular o valor do frete da formula apresentada
real distancia, peso, volume
real frete
// Infos
// Entrada de dados
escreva ("Digite o peso:")
leia (peso) 
escreva ("Digite a distancia:")
leia (distancia)
escreva ("Digite o volume:")
leia (volume) 
frete=15*+ (2*peso) + (0.05* distancia)
// mostra o resultado
escreva ("Valor do frete R$ + frete")

//Processamento
// Mostra resultados
//Saída















  }
}
