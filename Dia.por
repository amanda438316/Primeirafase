programa {
  funcao inicio() { 

inteiro numero 
  
    escreva("Digite um numero de 1 a 7:") 
    leia (numero) 

    
    se (numero ==1){
      escreva("domingo")
    }
    se (numero ==2) {
      escreva("Segunda")

    }
    se(numero == 3){
      escreva("Terça- feira") 
      
    }
    se(numero ==4){
      escreva("quarta- feira")
    }
    se(numero ==5){
      escreva("quinta- feira ")
    }
    
    
    se (numero == 6) {
      escreva("sexta- feira")

    }
    se (numero == 7) {
      escreva("sabado") 
    }
  
    

  
    
     
















































































































































































































































































































































































































































































































































































































































































































    















  }
}
